{
  "name": "legocraft",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "start": "node server/main.mjs",
    "test": "npm run test:server && npm run test:smoke && npm run test:remote && npm run test:touch && npm run test:saves",
    "test:server": "node --test server/*.test.mjs",
    "test:smoke": "node --import ./test/register.mjs test/smoke.mjs",
    "test:browser": "node test/browser.mjs",
    "test:remote": "node --import ./test/register.mjs test/remote-players.mjs",
    "test:touch": "node --test test/touch-gestures.mjs",
    "test:multiplayer-browser": "node --test test/multiplayer-browser.mjs",
    "test:saves": "node --test test/solo-saves.mjs",
    "test:saves-browser": "node --test test/saves-browser.mjs"
  },
  "dependencies": {
    "three": "0.160.0",
    "ws": "8.22.0"
  }
}
